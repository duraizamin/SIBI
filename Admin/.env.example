ADMIN_NAME=Sibi Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
SESSION_SECRET=replace-with-a-unique-random-secret
APP_TIMEZONE=Asia/Kolkata

# Select openwa or cloud_api. OpenWA is a separately hosted gateway. Locally use
# OPENWA_API_URL; hosted deployments should use the gateway's HTTPS endpoint.
WHATSAPP_PROVIDER=openwa
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Optional alternative provider: Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Optional: configure an approved Meta template with exactly one body variable ({{1}})
# for business-initiated messages outside the 24-hour customer service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Configure the webhook callback URL as https://YOUR-DOMAIN/api/whatsapp/webhook in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
# Optional but recommended: Meta App Secret for webhook signature verification.
WHATSAPP_APP_SECRET=

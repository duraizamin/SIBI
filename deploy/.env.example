# Public hostname for the Sibi website. Point its DNS A record at the VPS first.
SITE_DOMAIN=your-domain.example

# Set these before the first deployment. Use unique, strong values.
ADMIN_NAME=Sibi Administrator
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-64-random-hex-characters

# Fill these after starting OpenWA and linking the WhatsApp session.
OPENWA_API_KEY=
OPENWA_SESSION_ID=
